[Unit]
Description=Ben Brain API Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/SignatureSystems
Environment="PATH=/home/ubuntu/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/ubuntu/SignatureSystems"
ExecStart=/home/ubuntu/venv/bin/python -m uvicorn ben_api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
