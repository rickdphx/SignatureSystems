# Broker Selection (alpaca or schwab)
BROKER=schwab

# Alpaca API
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Schwab API
SCHWAB_APP_KEY=your_schwab_app_key
SCHWAB_APP_SECRET=your_schwab_app_secret
SCHWAB_CALLBACK_URL=https://localhost:8000/callback
SCHWAB_ACCOUNT_HASH=your_account_hash
SCHWAB_REFRESH_TOKEN=

# Polygon
POLYGON_API_KEY=your_polygon_key

# Benzinga (optional)
BENZINGA_API_KEY=your_benzinga_key

# Database
POSTGRES_URL=postgresql://user:pass@localhost:5432/momentum_bot
REDIS_URL=redis://localhost:6379

# Trading Config
MIN_PRICE=1.0
MAX_PRICE=20.0
MIN_RVOL=5.0
MIN_SIGNAL_SCORE=9
MAX_POSITION_SIZE=10000
SCAN_INTERVAL=5

# Risk Management
MAX_LOSS_PERCENT=2.0
TRAILING_STOP_ATR_MULTIPLIER=2.0
