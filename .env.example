# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://signaturechair:signaturechair_password@localhost:5432/signaturechair_booking?schema=public
POSTGRES_USER=signaturechair
POSTGRES_PASSWORD=signaturechair_password
POSTGRES_DB=signaturechair_booking
POSTGRES_PORT=5432

# Square API Configuration
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your_square_location_id_here

# Application Settings
DOMAIN=signaturechair.com
ALLOWED_ORIGINS=http://localhost:3000,https://signaturechair.com

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
